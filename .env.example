# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# EIA v2 API — free, instant signup: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# NOAA / NWS API requires no key, but demands a User-Agent with a contact address.
# See: https://www.weather.gov/documentation/services-web-api
NWS_USER_AGENT="(bellwether, your-email@example.com)"

# LLM for the explanation/brief layer (added in a later phase — not needed yet)
ANTHROPIC_API_KEY=
